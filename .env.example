# ============================================================
# Soulbound Certificate dApp — Environment Variables
# ============================================================
# Copy this file to .env and fill in the values.
# NEVER commit .env or any file containing private keys.
# ============================================================

# --- Hardhat / Deployment ---
# Sepolia RPC URL (from Alchemy, Infura, etc.)
SEPOLIA_RPC_URL=

# --- Frontend read-only RPC ---
# Optional CORS-enabled Sepolia endpoint for browser certificate lookups.
VITE_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com

# Deployer wallet private key (WITHOUT 0x prefix)
# This wallet becomes the contract owner/admin.
PRIVATE_KEY=

# --- IPFS (for real IPFS — optional for local dev) ---
# Pinata API credentials
IPFS_API_KEY=
IPFS_API_SECRET=
IPFS_GATEWAY_URL=https://gateway.pinata.cloud/ipfs/
